# Copy to .env or export in your MCP host config. Never commit real values.

# Postgres connection string for the least-privilege read-only role (see README).
DATABASE_URL=postgresql://astraeus_agent:CHANGE_ME@localhost:5432/appdb

# Path to the policy file (or pass --policy <file>).
ASTRAEUS_POLICY_PATH=./examples/policy.example.yaml

# Optional. Overrides audit.path in the policy.
# ASTRAEUS_AUDIT_PATH=./astraeus-audit.jsonl

# HTTP entrypoint only (node dist/http-main.js). Generate the token, e.g. openssl rand -hex 32.
# ASTRAEUS_HTTP_TOKEN=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
# ASTRAEUS_HTTP_HOST=127.0.0.1
# ASTRAEUS_HTTP_PORT=8787

# Smoke test, Docker alternative only (docker-compose.yml, SMOKE_TARGET=docker).
# The default `npm run smoke` uses an embedded Postgres and needs none of these. Choose throwaway local values.
# SMOKE_PG_ADMIN_PASSWORD=CHANGE_ME_ADMIN
# SMOKE_PG_AGENT_PASSWORD=CHANGE_ME_AGENT
