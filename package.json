{
  "name": "astraeus-postgres-mcp",
  "version": "0.1.0",
  "description": "Governed, read-only Postgres MCP server with policy allowlists, row limits, PII masking and an audit log.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "postgres",
    "governance",
    "read-only",
    "audit"
  ],
  "author": "Astraeus Business Solutions",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "pg": "^8.23.1",
    "pgsql-ast-parser": "^12.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "bin": {
    "astraeus-postgres-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SarutobiSasuke8/astraeus-postgres-mcp.git"
  }
}
